{
  "name": "@mauricio_castillo/collateral-health",
  "version": "0.0.1",
  "description": "Pure TypeScript library to compute the health status of a loan (Collateral Arrangement).",
  "keywords": [
    "collateral",
    "health",
    "loan",
    "margin",
    "liquidation",
    "ltv",
    "finance",
    "typescript"
  ],
  "license": "MIT",
  "author": "Mauricio Alan Castillo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlanMauricioCastillo/home-test-membrane-labs.git"
  },
  "bugs": {
    "url": "https://github.com/AlanMauricioCastillo/home-test-membrane-labs/issues"
  },
  "homepage": "https://github.com/AlanMauricioCastillo/home-test-membrane-labs#readme",
  "engines": {
    "node": ">=14"
  },
  "sideEffects": false,
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.cjs.json && tsc -p tsconfig.esm.json && tsc -p tsconfig.types.json && node scripts/postbuild.mjs",
    "dev": "tsx index.ts",
    "help": "tsx index.ts --help",
    "test": "jest",
    "prepublishOnly": "npm test && npm run build"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "tsx": "^4.23.12",
    "typescript": "^5.4.5"
  }
}
